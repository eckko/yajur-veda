  "lines_deva": [
   "सं॒व॒त्स॒रो॒ऽसि परिवत्स॒रो॒ऽसीदावत्स॒रो॒ऽसीद्वत्स॒रो॒ऽसि वत्स॒रो॒ऽसि",
   "उ॒षस॑स्ते कल्पन्तामहोरा॒त्रास्ते॑ कल्पन्तामर्धमा॒सास्ते॑ कल्पन्तां मा॒सास्ते कल्पन्तामृ॒तव॑स्ते कल्पन्ताᳪ संवत्स॒रस्ते॑ कल्पताम् । प्रेत्या॒ एत्यै॒ सं चाञ्च॒ प्र च॑ सारय",
   "सुप॒र्ण॒चिद॑सि॒ तया॑ दे॒वत॑याऽङ्गिर॒स्वद् ध्रु॒वः सी॑द"
  ],
  "lines_iast": [
   "sa̱ṃva̱tsa̱ro̱'si parivatsa̱ro̱'sīdāvatsa̱ro̱'sīdvatsa̱ro̱'si vatsa̱ro̱'si",
   "u̱ṣasa̭ste kalpantāmahorā̱trāstḙ kalpantāmardhamā̱sāstḙ kalpantāṃ mā̱sāste kalpantāmṛ̱tava̭ste kalpantāᳪ saṃvatsa̱rastḙ kalpatām | pretyā̱ etyai̱ saṃ cāñca̱ pra ca̭ sāraya",
   "supa̱rṇa̱cida̭si̱ tayā̭ de̱vata̭yā'ṅgira̱svad dhru̱vaḥ sī̭da"
  ],
