  "lines_deva": [
   "समा॑स्त्वाग्न ऋ॒तवो॑ वर्धयन्तु संवत्स॒रा ऋष॑यो॒ यानि॑ स॒त्या",
   "सं दि॒व्येन॑ दीदिहि रोच॒नेन॒ विश्वा॒ आ भा॑हि प्र॒दिश॒श्चत॑स्रः"
  ],
  "lines_iast": [
   "samā̭stvāgna ṛ̱tavo̭ vardhayantu saṃvatsa̱rā ṛṣa̭yo̱ yāni̭ sa̱tyā",
   "saṃ di̱vyena̭ dīdihi roca̱nena̱ viśvā̱ ā bhā̭hi pra̱diśa̱ścata̭sraḥ"
  ],
